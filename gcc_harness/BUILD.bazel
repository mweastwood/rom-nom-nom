cc_test(
    name = "gcc_harness_test",
    size = "medium",
    testonly = True,
    srcs = ["gcc_harness_test.cc"],
    linkstatic = True,
    deps = [
        ":function_hooks",
        ":gcc_context",
        ":right_inverse_verifier",
        ":subfunction_inverse_provider",
        ":toy_subfunction_inverses",
        "//core:c_ast",
        "//core:rtl_cfg",
        "//core:rtl_expr",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "compilation_trace_test",
    size = "medium",
    testonly = True,
    srcs = ["compilation_trace_test.cc"],
    data = ["//toolchain:all_files"],
    linkstatic = True,
    deps = [
        ":function_hooks",
        ":gcc_context",
        ":right_inverse_verifier",
        "//core:compiler",
        "//core:elf_reader",
        "//core:round_trip_test_cases",
        "//core:rtl_cfg",
        "//core:rtl_sexpr_utils",
        "//core:toolchain",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

