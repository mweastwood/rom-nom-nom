load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load(":coverage_flag.bzl", "bool_flag")
load(":shared_corpus_traces.bzl", "shared_corpus_trace_shards")

package(
    default_testonly = True,
    default_visibility = ["//visibility:public"],
)

bool_flag(
    name = "coverage",
    build_setting_default = False,
)

config_setting(
    name = "gcc_harness_coverage_enabled",
    flag_values = {":coverage": "true"},
)

cc_library(
    name = "gcc_context",
    testonly = True,
    srcs = ["gcc_context.cc"],
    hdrs = ["gcc_context.h"],
    linkopts = [
        "-Wl,--wrap=immed_double_const",
        "-Wl,--wrap=immed_real_const",
        "-Wl,--wrap=immed_real_const_1",
        "-Wl,--wrap=force_const_mem",
        "-Wl,--wrap=reload",
    ] + select({
        ":gcc_harness_coverage_enabled": ["-lgcov"],
        "//conditions:default": [],
    }),
    deps = [
        "//core:c_ast",
        "//core:rtl_cfg",
        "//core:rtl_expr",
        "//core:rtl_sexpr_utils",
        "//toolchain:gas26_harness_lib",
        "@abseil-cpp//absl/base",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ] + select({
        ":gcc_harness_coverage_enabled": ["//toolchain:gcc272_harness_cov_lib"],
        "//conditions:default": ["//toolchain:gcc272_harness_lib"],
    }),
)

cc_library(
    name = "function_hooks",
    testonly = True,
    srcs = ["function_hooks.cc"],
    hdrs = ["function_hooks.h"],
    deps = [
        ":gcc_context",
        "//core:c_ast",
        "//core:round_trip_test_cases",
        "//core:rtl_cfg",
        "//core:rtl_expr",
        "//core:rtl_sexpr_utils",
        "//toolchain:gas26_harness_lib",
        "@abseil-cpp//absl/base",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ] + select({
        ":gcc_harness_coverage_enabled": ["//toolchain:gcc272_harness_cov_lib"],
        "//conditions:default": ["//toolchain:gcc272_harness_lib"],
    }),
)

cc_library(
    name = "subfunction_inverse_provider",
    testonly = True,
    hdrs = ["subfunction_inverse_provider.h"],
    deps = [
        "//core:c_ast",
        "//core:rtl_cfg",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/types:span",
    ],
)

