    srcs = ["right_inverse_verifier.cc"],
    hdrs = ["right_inverse_verifier.h"],
    deps = [
        ":function_hooks",
        ":gcc_context",
        ":subfunction_inverse_provider",
        ":toy_subfunction_inverses",
        "//core:c_ast",
        "//core:rtl_cfg",
        "//core:rtl_expr",
        "//core:rtl_sexpr_utils",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:flat_hash_set",
        "@abseil-cpp//absl/status",
