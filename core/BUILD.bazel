load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "mips",
    srcs = ["mips.cc"],
    hdrs = ["mips.h"],
    copts = ["-std=c++20"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "mips_test",
    srcs = ["mips_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":mips",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "sha1",
    srcs = ["sha1.cc"],
    hdrs = ["sha1.h"],
    copts = ["-std=c++20"],
    deps = [
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "sha1_test",
    srcs = ["sha1_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":sha1",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "rom",
    srcs = ["rom.cc"],
    hdrs = ["rom.h"],
    copts = ["-std=c++20"],
    deps = [
        ":sha1",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "rom_test",
    srcs = ["rom_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":rom",
        ":sha1",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)

