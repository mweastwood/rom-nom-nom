#!/usr/bin/env bash
#
# Git pre-commit hook to guarantee all C and C++ sources are formatted with
# clang-format and conform to Google style conventions via clang-tidy.
#
set -euo pipefail

# Get staged C and C++ files (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cc|cpp|h)$' || true)

if [[ -z "$STAGED_FILES" ]]; then
    exit 0
fi

# 1. Format verification / auto-format with clang-format
if ! command -v clang-format >/dev/null 2>&1; then
    echo "[pre-commit] WARNING: clang-format not found in PATH. Skipping formatting check."
else
    for file in $STAGED_FILES; do
        if [[ ! -f "$file" ]]; then
            continue
        fi

        # Check if file conforms to .clang-format
        if ! clang-format --dry-run --Werror "$file" >/dev/null 2>&1; then
            echo "[pre-commit] Formatting $file with clang-format..."
            clang-format -i "$file"
            git add "$file"
        fi
    done
fi

# 2. Google style & naming verification with clang-tidy
if ! command -v clang-tidy >/dev/null 2>&1; then
    echo "[pre-commit] WARNING: clang-tidy not found in PATH. Skipping style/naming check."
else
    echo "[pre-commit] Verifying Google style and naming conventions with clang-tidy..."
    python3 tools/tidy.py --check $STAGED_FILES
fi

exit 0
