load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_library(
    name = "normalizer",
    srcs = ["normalizer.cc"],
    hdrs = ["normalizer.h"],
    deps = [
        "//core:mips",
    ],
)

cc_test(
    name = "normalizer_test",
    srcs = ["normalizer_test.cc"],
    deps = [
        ":normalizer",
        "//core:mips",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "sequence_aligner",
    srcs = ["sequence_aligner.cc"],
    hdrs = ["sequence_aligner.h"],
    deps = [
        ":normalizer",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "sequence_aligner_test",
    srcs = ["sequence_aligner_test.cc"],
    deps = [
        ":normalizer",
        ":sequence_aligner",
        "//core:mips",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "diff_formatter",
    srcs = ["diff_formatter.cc"],
    hdrs = ["diff_formatter.h"],
    deps = [
        ":normalizer",
        ":sequence_aligner",
        "//core:mips",
        "//core:symbol_registry",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_test(
    name = "diff_formatter_test",
    srcs = ["diff_formatter_test.cc"],
    deps = [
        ":diff_formatter",
        ":normalizer",
        ":sequence_aligner",
        "//core:mips",
        "//core:symbol_registry",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "differ_pipeline",
    srcs = ["differ_pipeline.cc"],
    hdrs = ["differ_pipeline.h"],
    deps = [
        ":diff_formatter",
        ":normalizer",
        ":sequence_aligner",
        "//core:compiler",
        "//core:elf_reader",
        "//core:game_config",
        "//core:mips",
        "//core:relocation_applier",
        "//core:symbol_registry",
        "//core:target_extractor",
        "//core:toolchain",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_test(
    name = "differ_pipeline_test",
    srcs = ["differ_pipeline_test.cc"],
    deps = [
        ":differ_pipeline",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_library(
    name = "rom_differ",
    srcs = ["rom_differ.cc"],
    hdrs = ["rom_differ.h"],
    deps = [
        "//core:game_config",
        "//core:sha1",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:span",
    ],
)

cc_test(
    name = "rom_differ_test",
    srcs = ["rom_differ_test.cc"],
    deps = [
        ":rom_differ",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "differ",
    srcs = ["main.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":differ_pipeline",
        ":rom_differ",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
    ],
)
