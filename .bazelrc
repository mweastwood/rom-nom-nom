build --cxxopt=-std=c++20
build --cxxopt=-fno-exceptions
build --host_cxxopt=-std=c++20
build --host_cxxopt=-fno-exceptions

# Treat external repository headers as system headers (-isystem)
build --features=external_include_paths
build --host_features=external_include_paths

# Enforce -Wall -Werror on first-party sources and silence warnings in external repos
build --per_file_copt=-external/.*@-Wall,-Werror
build --host_per_file_copt=-external/.*@-Wall,-Werror
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w
