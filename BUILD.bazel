# Test targets verifying byte-for-byte exact match against original ROM using original toolchain
py_test(
    name = "match_harvest_moon_64_test",
    size = "small",
    srcs = [
        "//tools:build.py",
        "//tools:install_toolchain.py",
    ],
    args = [
        "harvest-moon-64",
        "--toolchain=original",
        "--test",
    ],
    data = [
        "//splat:harvest-moon-64",
        "//symbols:harvest-moon-64",
    ],
    main = "//tools:build.py",
    tags = ["local"],
    deps = [
        "@pip//pyyaml",
        "@pip//spimdisasm",
    ],
)

