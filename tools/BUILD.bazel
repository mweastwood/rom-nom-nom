load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

py_binary(
    name = "split",
    srcs = ["split.py"],
    deps = [
        "@pip//pyyaml",
    ],
    main = "split.py",
)

py_binary(
    name = "build",
    srcs = [
        "build.py",
        "install_toolchain.py",
    ],
    deps = [
        "@pip//pyyaml",
        "@pip//spimdisasm",
    ],
    main = "build.py",
)

py_binary(
    name = "install_toolchain",
    srcs = ["install_toolchain.py"],
    main = "install_toolchain.py",
)

py_binary(
    name = "format",
    srcs = ["format.py"],
    main = "format.py",
)
